<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Taku Vault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-gray-900">
    <nav class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <%= link_to "Taku Vault", root_path, class: "text-lg font-semibold text-orange-700" %>

        <div class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <%= button_to "ログアウト",
                          destroy_user_session_path,
                          method: :delete,
                          form: { data: { turbo: true }, class: "inline" },
                          class: "cursor-pointer border-none bg-transparent p-0 text-gray-700 hover:text-orange-700" %>
          <% else %>
            <%= link_to "ログイン",
                        new_user_session_path,
                        class: "text-gray-700 hover:text-orange-700" %>
            <%= link_to "新規登録",
                        new_user_registration_path,
                        class: "text-gray-700 hover:text-orange-700" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% main_width_class = controller_path == "sessions" && action_name == "show" ? "max-w-7xl" : "max-w-5xl" %>
    <main class="mx-auto <%= main_width_class %> px-4 py-6">
      <%= render "layouts/flash" %>

      <%= yield %>
    </main>
  </body>
</html>
