<h1><%= @asset.display_name %></h1>

<p><%= t(".display_name_label", locale: :ja) %>: <%= @asset.display_name %></p>
<p><%= t(".original_filename_label", locale: :ja) %>: <%= @asset.original_filename %></p>

<% if @asset.file.attached? %>
  <p>
    <%= link_to t("assets.common.download", locale: :ja),
                asset_file_download_path(@asset) %>
  </p>
<% end %>

<h2><%= t(".details_heading", locale: :ja) %></h2>

<% if @where_used_usages.any? %>
  <table>
    <thead>
      <tr>
        <th><%= t("assets.common.session", locale: :ja) %></th>
        <th><%= t("assets.common.scene", locale: :ja) %></th>
        <th><%= t("assets.common.kind", locale: :ja) %></th>
      </tr>
    </thead>
    <tbody>
      <% @where_used_usages.each do |usage| %>
        <% usage_update_form_id = "usage_update_#{usage.id}" %>
        <tr>
          <td><%= link_to usage.session.name, game_session_path(usage.session) %></td>
          <td>
            <%= form_with url: usage_path(usage),
                          method: :patch,
                          html: { id: usage_update_form_id } do %>
              <%= select_tag :scene_id,
                             options_for_select(
                               usage.session.scenes.sort_by(&:position).map { |scene|
                                 [ scene.name, scene.id ]
                               },
                               usage.scene_id
                             ),
                             include_blank: t("assets.common.select_prompt", locale: :ja),
                             id: "usage_scene_id_#{usage.id}",
                             aria: { label: t("assets.common.scene", locale: :ja) },
                             class: "usage-scene-select" %>
            <% end %>
          </td>
          <td>
            <%= select_tag :role,
                           options_for_select(
                             @roles.map { |role| [ Usage.role_label(role), role ] },
                             usage.role
                           ),
                           include_blank: t("assets.common.select_prompt", locale: :ja),
                           id: "usage_role_#{usage.id}",
                           form: usage_update_form_id,
                           aria: { label: t("assets.common.kind", locale: :ja) },
                           class: "usage-role-select" %>
            <%= submit_tag t("assets.common.update", locale: :ja),
                           form: usage_update_form_id %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t(".details_empty", locale: :ja) %></p>
  <p><%= link_to t("assets.common.uncategorized_index", locale: :ja), uncategorized_assets_path %></p>
<% end %>

<h2><%= t(".add_details_heading", locale: :ja) %></h2>

<% if @sessions.any? %>
  <%= form_with url: usages_path, method: :post, data: { controller: "scene-select" } do |form| %>
    <%= hidden_field_tag :asset_id, @asset.id %>

    <p>
      <%= form.label :session_id, t("assets.common.session", locale: :ja) %>
      <%= form.select :session_id,
                      @sessions.map { |session| [ session.name, session.id ] },
                      { prompt: t("assets.common.select_prompt", locale: :ja) },
                      data: {
                        scene_select_target: "session",
                        action: "scene-select#update"
                      } %>
    </p>

    <p>
      <%= form.label :scene_id, t("assets.common.scene", locale: :ja) %>
      <%= form.select :scene_id,
                      @sessions.flat_map { |session|
                        session.scenes.sort_by(&:position).map do |scene|
                          [ "#{session.name} / #{scene.name}", scene.id, { data: { session_id: session.id } } ]
                        end
                      },
                      { prompt: t("assets.common.select_prompt", locale: :ja) },
                      data: { scene_select_target: "scene" } %>
    </p>

    <p>
      <%= form.label :role, t("assets.common.kind", locale: :ja) %>
      <%= form.select :role,
                      @roles.map { |role| [ Usage.role_label(role), role ] },
                      prompt: t("assets.common.select_prompt", locale: :ja) %>
    </p>

    <%= form.submit t(".add_details_submit", locale: :ja) %>
  <% end %>
<% else %>
  <p><%= t(".add_details_without_sessions", locale: :ja) %></p>
<% end %>

<p>
  <%= link_to t("assets.common.edit", locale: :ja), edit_asset_path(@asset) %>
  <%= link_to t("assets.common.back_to_index", locale: :ja), assets_path %>
  <%= button_to t("assets.common.delete", locale: :ja), asset_path(@asset),
                method: :delete,
                data: { turbo_confirm: t("assets.common.delete_confirm", locale: :ja) } %>
</p>
