<h1>素材詳細</h1>

<p>表示名: <%= @asset.display_name %></p>
<p>元ファイル名: <%= @asset.original_filename %></p>

<% if @asset.file.attached? %>
  <p>
    <%= link_to "ダウンロード",
                rails_blob_path(@asset.file, disposition: "attachment") %>
  </p>
<% end %>

<h2>使用先</h2>

<% if @where_used_usages.any? %>
  <table>
    <thead>
      <tr>
        <th>セッション</th>
        <th>シーン</th>
        <th>用途</th>
      </tr>
    </thead>
    <tbody>
      <% @where_used_usages.each do |usage| %>
        <% usage_update_form_id = "usage_update_#{usage.id}" %>
        <tr>
          <td><%= link_to usage.session.name, game_session_path(usage.session) %></td>
          <td>
            <%= form_with url: usage_path(usage),
                          method: :patch,
                          html: { id: usage_update_form_id } do %>
              <%= select_tag :scene_id,
                             options_for_select(
                               usage.session.scenes.sort_by(&:position).map { |scene|
                                 [ scene.name, scene.id ]
                               },
                               usage.scene_id
                             ),
                             include_blank: "選択してください",
                             id: "usage_scene_id_#{usage.id}",
                             aria: { label: "シーン" },
                             class: "usage-scene-select" %>
            <% end %>
          </td>
          <td>
            <%= select_tag :role,
                           options_for_select(
                             @roles.map { |role| [ Usage.role_label(role), role ] },
                             usage.role
                           ),
                           include_blank: "選択してください",
                           id: "usage_role_#{usage.id}",
                           form: usage_update_form_id,
                           aria: { label: "用途" },
                           class: "usage-role-select" %>
            <%= submit_tag "更新", form: usage_update_form_id %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>使用先：未設定（未整理）</p>
  <p><%= link_to "未整理一覧へ", uncategorized_assets_path %></p>
<% end %>

<h2>Usage追加</h2>

<% if @sessions.any? %>
  <%= form_with url: usages_path, method: :post, data: { controller: "scene-select" } do |form| %>
    <%= hidden_field_tag :asset_id, @asset.id %>

    <p>
      <%= form.label :session_id, "セッション" %>
      <%= form.select :session_id,
                      @sessions.map { |session| [ session.name, session.id ] },
                      { prompt: "選択してください" },
                      data: {
                        scene_select_target: "session",
                        action: "scene-select#update"
                      } %>
    </p>

    <p>
      <%= form.label :scene_id, "シーン" %>
      <%= form.select :scene_id,
                      @sessions.flat_map { |session|
                        session.scenes.sort_by(&:position).map do |scene|
                          [ "#{session.name} / #{scene.name}", scene.id, { data: { session_id: session.id } } ]
                        end
                      },
                      { prompt: "選択してください" },
                      data: { scene_select_target: "scene" } %>
    </p>

    <p>
      <%= form.label :role, "役割" %>
      <%= form.select :role,
                      @roles.map { |role| [ Usage.role_label(role), role ] },
                      prompt: "選択してください" %>
    </p>

    <%= form.submit "Usageを追加" %>
  <% end %>
<% else %>
  <p>Usageを追加するにはセッションを作成してください。</p>
<% end %>

<p>
  <%= link_to "編集", edit_asset_path(@asset) %>
  <%= link_to "一覧へ戻る", assets_path %>
  <%= button_to "削除", asset_path(@asset),
                method: :delete,
                data: { turbo_confirm: "削除しますか？" } %>
</p>
