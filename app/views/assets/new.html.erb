<h1 class="mb-4 text-2xl font-semibold text-gray-900">素材アップロード</h1>

<div class="mb-6">
  <%= link_to "一覧へ戻る",
              assets_path,
              class: "text-orange-700 hover:text-orange-800 hover:underline" %>
</div>

<%= form_with model: @asset, url: assets_path, html: { class: "rounded-lg border border-gray-200 bg-white p-4 shadow-sm" } do |form| %>
  <div class="mb-4">
    <%= form.label :files, "ファイルを選択", class: "block text-sm font-medium text-gray-700" %>
    <%= form.file_field :files,
                        multiple: true,
                        direct_upload: false,
                        include_hidden: false,
                        class: "mt-1 block w-full text-sm text-gray-700 file:mr-3 file:rounded-md file:border-0 file:bg-orange-700 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white" %>
  </div>

  <div>
    <%= form.submit "アップロード",
                    class: "inline-flex items-center rounded-md bg-orange-700 px-4 py-2 text-sm font-medium text-white hover:bg-orange-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
  </div>
<% end %>
