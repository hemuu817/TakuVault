<h1>素材一覧</h1>

<p>
  <%= link_to "新規アップロード", new_asset_path %>
  <%= link_to "未整理の素材", uncategorized_assets_path %>
  <%= link_to "セッション一覧", game_sessions_path %>
</p>

<% if @assets.any? %>
  <ul>
    <% @assets.each do |asset| %>
      <li>
        <%= link_to asset.display_name, asset_path(asset) %>
        (<%= asset.original_filename %>)
        <%= link_to "編集", edit_asset_path(asset) %>
        <%= button_to "削除", asset_path(asset),
                      method: :delete,
                      data: { turbo_confirm: "削除しますか？" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>素材がまだありません。</p>
<% end %>
