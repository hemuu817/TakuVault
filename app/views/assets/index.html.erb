<h1 class="mb-4 text-2xl font-semibold text-gray-900">素材一覧</h1>

<div class="mb-6 flex flex-wrap gap-3">
  <%= link_to "新規アップロード",
              new_asset_path,
              class: "inline-flex items-center rounded-md bg-orange-700 px-4 py-2 text-sm font-medium text-white hover:bg-orange-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
  <%= link_to "未整理の素材",
              uncategorized_assets_path,
              class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
  <%= link_to "セッション一覧",
              game_sessions_path,
              class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
</div>

<% if @assets.any? %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @assets.each do |asset| %>
      <li class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
        <div class="space-y-3">
          <div>
            <%= link_to asset.display_name,
                        asset_path(asset),
                        class: "text-base font-semibold text-orange-700 hover:text-orange-800 hover:underline" %>
            <p class="mt-1 break-all text-sm text-gray-600"><%= asset.original_filename %></p>
          </div>

          <div class="flex flex-wrap gap-2">
            <%= link_to "編集",
                        edit_asset_path(asset),
                        class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
        <%= button_to "削除", asset_path(asset),
                      method: :delete,
                      data: { turbo_confirm: "削除しますか？" },
                      form: { class: "inline" },
                      class: "inline-flex items-center rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2" %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-md border border-gray-200 bg-white px-4 py-6 text-sm text-gray-600">素材がまだありません。</p>
<% end %>
