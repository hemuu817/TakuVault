<aside class="min-w-0" data-session-switcher-target="list">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-gray-900">セッション一覧</h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to "新規作成",
                  new_game_session_path,
                  class: "inline-flex items-center rounded-md bg-orange-700 px-3 py-2 text-sm font-medium text-white hover:bg-orange-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
      <%= link_to "素材一覧",
                  assets_path,
                  class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
    </div>
  </div>

  <% if sessions.any? %>
    <ul class="max-h-[70vh] space-y-3 overflow-y-auto pr-1">
      <% sessions.each do |session_record| %>
        <% selected = selected_session&.id == session_record.id %>
        <li class="rounded-lg border bg-white p-4 shadow-sm <%= selected ? "border-orange-500 ring-1 ring-orange-500" : "border-gray-200" %>"
            <% if selected %>aria-current="page"<% end %>>
          <%= link_to session_record.name,
                      game_session_path(session_record),
                      data: { action: "click->session-switcher#select", turbo: false },
                      class: "block break-words text-base font-semibold text-orange-700 hover:text-orange-800 hover:underline" %>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= link_to "編集",
                        edit_game_session_path(session_record),
                        class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
            <%= button_to "削除",
                          game_session_path(session_record),
                          method: :delete,
                          params: { selected_session_id: selected_session&.id },
                          data: { turbo_confirm: "削除しますか？" },
                          form: { class: "inline" },
                          class: "inline-flex items-center rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="rounded-md border border-gray-200 bg-white px-4 py-6 text-sm text-gray-600">
      <p>セッションがまだありません。</p>
      <%= link_to "最初のセッションを作成",
                  new_game_session_path,
                  class: "mt-3 inline-flex font-medium text-orange-700 hover:text-orange-800 hover:underline" %>
    </div>
  <% end %>
</aside>
