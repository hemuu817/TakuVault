<h1>セッション詳細</h1>

<p>セッション名: <%= @session.name %></p>

<% if @session.room_url.present? %>
  <p>
    部屋URL:
    <%= link_to @session.room_url, @session.room_url,
                target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>

<p>
  <%= link_to "編集", edit_game_session_path(@session) %>
  <%= link_to "一覧へ戻る", game_sessions_path %>
  <%= button_to "削除", game_session_path(@session),
                method: :delete,
                data: { turbo_confirm: "削除しますか？" } %>
</p>

<h2>シーン</h2>

<p>
  <%= link_to "シーンを追加", new_game_session_scene_path(@session) %>
</p>

<% scenes = @asset_grid.scenes %>
<% if scenes.any? %>
  <ul>
    <% scenes.each do |scene| %>
      <li>
        <%= scene.position %>.
        <%= link_to scene.name, game_session_scene_path(@session, scene) %>
        <%= link_to "編集", edit_game_session_scene_path(@session, scene) %>
        <% unless scene.default_scene? %>
          <%= button_to "削除", game_session_scene_path(@session, scene),
                        method: :delete,
                        data: { turbo_confirm: "削除しますか？" } %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>シーンがありません。</p>
<% end %>

<h2>セッション素材一覧</h2>

<table>
  <thead>
    <tr>
      <th>シーン</th>
      <% @asset_grid.roles.each do |role| %>
        <th><%= Usage.role_label(role) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @asset_grid.scenes.each do |scene| %>
      <tr>
        <th><%= scene.name %></th>
        <% @asset_grid.roles.each do |role| %>
          <td>
            <% @asset_grid.usages_for(scene, role).each do |usage| %>
              <% thumbnail_src = asset_file_thumbnail_src(usage.asset) %>
              <%= link_to asset_path(usage.asset) do %>
                <% if thumbnail_src.present? %>
                  <%= image_tag thumbnail_src, alt: usage.asset.display_name, width: 120 %>
                <% end %>
                <span><%= usage.asset.display_name %></span>
              <% end %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
