<div class="mx-auto max-w-md">
  <h1 class="mb-4 text-2xl font-semibold text-gray-900">Sign up</h1>

  <%= form_for(resource,
               as: resource_name,
               url: registration_path(resource_name),
               html: { class: "rounded-lg border border-gray-200 bg-white p-4 shadow-sm" }) do |form| %>
    <% if resource.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <ul class="space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email,
                           autofocus: true,
                           autocomplete: "email",
                           class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 focus:border-orange-600 focus:outline-hidden focus:ring-2 focus:ring-orange-600" %>
    </div>

    <div class="mb-4">
      <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-sm text-gray-600"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
      <%= form.password_field :password,
                              autocomplete: "new-password",
                              class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 focus:border-orange-600 focus:outline-hidden focus:ring-2 focus:ring-orange-600" %>
    </div>

    <div class="mb-4">
      <%= form.label :password_confirmation, "Password confirmation", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password_confirmation,
                              autocomplete: "new-password",
                              class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 focus:border-orange-600 focus:outline-hidden focus:ring-2 focus:ring-orange-600" %>
    </div>

    <%= form.submit "Sign up",
                    class: "inline-flex w-full items-center justify-center rounded-md bg-orange-700 px-4 py-2 text-sm font-medium text-white hover:bg-orange-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2" %>
  <% end %>
</div>
